{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/index.ts",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
